generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["platform", "public"]
}

// ===== Auth.js 认证表 =====
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  threads       Thread[] // 用户的所有会话
  projects      Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("platform")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED

  @@schema("platform")
}

enum DeploymentStatus {
  BUILDING
  ACTIVE
  FAILED
  SUPERSEDED
  DISABLED

  @@schema("platform")
}

enum RuntimeType {
  STATIC
  GO

  @@schema("platform")
}

enum BuildJobType {
  FULLSTACK_PREVIEW
  PUBLISH
  UNPUBLISH

  @@schema("platform")
}

enum BuildJobStatus {
  QUEUED
  BUILDING
  MIGRATING
  TESTING
  STARTING
  VERIFYING
  SUCCEEDED
  FAILED

  @@schema("platform")
}

model Project {
  id                 String        @id @default(uuid())
  userId             String
  name               String
  description        String?
  slug               String        @unique
  status             ProjectStatus @default(ACTIVE)
  activeDeploymentId String?       @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread           Thread?
  artifact         Artifact?
  deployments      Deployment[] @relation("ProjectDeployments")
  activeDeployment Deployment?  @relation("ActiveDeployment", fields: [activeDeploymentId], references: [id], onDelete: SetNull)
  buildJobs        BuildJob[]
  draftWorkspaces  DraftWorkspace[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@schema("platform")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("platform")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("platform")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("platform")
}

// ===== 应用业务表 =====
model Thread {
  id        String   @id @default(uuid())
  title     String
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联用户
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@schema("platform")
}

model Artifact {
  id        String            @id @default(uuid())
  projectId String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  ArtifactVersion[]

  @@schema("platform")
}

model ArtifactVersion {
  id                  String       @id @default(uuid())
  artifactId          String
  versionNumber       Int
  description         String?
  generationRequestId String?      @unique
  createdAt           DateTime     @default(now())
  requirementSpec     Json?
  appBlueprint        Json?
  runtimeManifest     Json?
  runtimeVersion      String?
  fileManifest        Json?
  artifact            Artifact     @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  files               File[]
  shares              Share[] // 分享记录
  deployments         Deployment[]
  buildJobs           BuildJob[]
  draftOrigins        DraftWorkspace[]

  @@unique([artifactId, versionNumber])
  @@schema("platform")
}

enum DraftWorkspaceStatus {
  ACTIVE
  CLOSED

  @@schema("platform")
}

model DraftWorkspace {
  id                    String               @id @default(uuid())
  projectId             String
  taskId                String               @unique
  baseArtifactVersionId String?
  status                DraftWorkspaceStatus @default(ACTIVE)
  revision              Int                  @default(0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  project               Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  baseArtifactVersion   ArtifactVersion?     @relation(fields: [baseArtifactVersionId], references: [id], onDelete: Restrict)
  files                 DraftFile[]
  fileRevisions         DraftFileRevision[]
  writeReceipts         DraftWriteReceipt[]
  fileChanges           DraftFileChange[]
  validationRuns        DraftValidationRun[]

  @@index([projectId, createdAt])
  @@schema("platform")
}

model DraftFile {
  workspaceId String
  path        String
  content     String   @db.Text
  sha256      String
  revision    Int
  workspace   DraftWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, path])
  @@schema("platform")
}

model DraftFileRevision {
  workspaceId String
  path        String
  revision    Int
  content     String?  @db.Text
  sha256      String?
  workspace   DraftWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, path, revision])
  @@index([workspaceId, revision])
  @@schema("platform")
}

model DraftWriteReceipt {
  workspaceId String
  toolCallId  String
  inputHash   String
  revision    Int
  path        String
  sha256      String
  workspace   DraftWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, toolCallId])
  @@schema("platform")
}

model DraftFileChange {
  workspaceId  String
  revision     Int
  toolCallId   String
  path         String
  beforeSha256 String?
  afterSha256  String?
  createdAt    DateTime @default(now())
  workspace    DraftWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, revision])
  @@unique([workspaceId, toolCallId])
  @@schema("platform")
}

model DraftValidationRun {
  id          String   @id @default(uuid())
  workspaceId String
  revision    Int
  runtimeType RuntimeType
  status      String
  checks      Json
  diagnostics Json
  createdAt   DateTime @default(now())
  workspace   DraftWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, revision, createdAt])
  @@schema("platform")
}

model Deployment {
  id                String           @id @default(uuid())
  projectId         String
  artifactVersionId String
  status            DeploymentStatus @default(BUILDING)
  buildPath         String?
  errorMessage      String?          @db.Text
  createdAt         DateTime         @default(now())
  activatedAt       DateTime?
  runtimeType       RuntimeType      @default(STATIC)
  imageRef          String?
  migrationVersion  String?
  verification      Json?
  endpoint          String?

  project          Project         @relation("ProjectDeployments", fields: [projectId], references: [id], onDelete: Cascade)
  artifactVersion  ArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Restrict)
  activeForProject Project?        @relation("ActiveDeployment")
  buildJobs        BuildJob[]

  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@schema("platform")
}

model BuildJob {
  id                String         @id @default(uuid())
  type              BuildJobType
  status            BuildJobStatus @default(QUEUED)
  projectId         String
  artifactVersionId String
  deploymentId      String?
  attempt           Int            @default(0)
  leaseToken        String?        @unique
  leaseExpiresAt    DateTime?
  log               String?        @db.Text
  errorMessage      String?        @db.Text
  previewUrl        String?
  imageRef          String?
  createdAt         DateTime       @default(now())
  startedAt         DateTime?
  completedAt       DateTime?

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifactVersion ArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)
  deployment      Deployment?     @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([projectId, createdAt])
  @@index([artifactVersionId, type, status])
  @@schema("platform")
}

model File {
  id                String          @id @default(uuid())
  artifactVersionId String
  path              String
  content           String
  artifactVersion   ArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)

  @@unique([artifactVersionId, path])
  @@schema("platform")
}

// 分享表
model Share {
  id                String          @id @default(uuid())
  shareCode         String          @unique @default(uuid()) // 分享链接唯一码
  artifactVersionId String
  artifactVersion   ArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@index([shareCode])
  @@schema("platform")
}

/// MCP 服务器配置表
model MCPConfig {
  id          String   @id @default(uuid())
  name        String
  url         String
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("platform")
}

model checkpoint_blobs {
  thread_id     String
  checkpoint_ns String @default("")
  channel       String
  version       String
  type          String
  blob          Bytes?

  @@id([thread_id, checkpoint_ns, channel, version])
  @@schema("public")
}

model checkpoint_migrations {
  v Int @id

  @@schema("public")
}

model checkpoint_writes {
  thread_id     String
  checkpoint_ns String  @default("")
  checkpoint_id String
  task_id       String
  idx           Int
  channel       String
  type          String?
  blob          Bytes

  @@id([thread_id, checkpoint_ns, checkpoint_id, task_id, idx])
  @@schema("public")
}

model checkpoints {
  thread_id            String
  checkpoint_ns        String  @default("")
  checkpoint_id        String
  parent_checkpoint_id String?
  type                 String?
  checkpoint           Json
  metadata             Json    @default("{}")

  @@id([thread_id, checkpoint_ns, checkpoint_id])
  @@schema("public")
}
