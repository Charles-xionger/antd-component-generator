generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== Auth.js 认证表 =====
model User {
  id                  String               @id @default(uuid())
  name                String?
  email               String?              @unique
  emailVerified       DateTime?
  image               String?
  accounts            Account[]
  sessions            Session[]
  threads             Thread[] // 用户的所有会话
  projects            Project[]
  createdDataRecords  DataRecord[]         @relation("DataRecordCreatedBy")
  updatedDataRecords  DataRecord[]         @relation("DataRecordUpdatedBy")
  dataRecordRevisions DataRecordRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum DeploymentStatus {
  BUILDING
  ACTIVE
  FAILED
  SUPERSEDED
  DISABLED
}

enum DataEnvironment {
  DRAFT
  PRODUCTION
}

enum DataSchemaStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum DataMigrationStatus {
  PENDING
  APPLYING
  SUCCEEDED
  FAILED
}

enum DataRecordOperation {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

model Project {
  id                 String        @id @default(uuid())
  userId             String
  name               String
  description        String?
  slug               String        @unique
  status             ProjectStatus @default(ACTIVE)
  activeDeploymentId String?       @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread           Thread?
  artifact         Artifact?
  deployments      Deployment[]     @relation("ProjectDeployments")
  activeDeployment Deployment?      @relation("ActiveDeployment", fields: [activeDeploymentId], references: [id], onDelete: SetNull)
  dataCollections  DataCollection[]
  dataRecords      DataRecord[]
  dataMigrations   DataMigration[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===== 应用业务表 =====
model Thread {
  id        String   @id @default(uuid())
  title     String
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联用户
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
}

model Artifact {
  id        String            @id @default(uuid())
  projectId String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  ArtifactVersion[]
}

model ArtifactVersion {
  id                  String       @id @default(uuid())
  artifactId          String
  versionNumber       Int
  description         String?
  generationRequestId String?      @unique
  createdAt           DateTime     @default(now())
  artifact            Artifact     @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  files               File[]
  shares              Share[] // 分享记录
  deployments         Deployment[]

  @@unique([artifactId, versionNumber])
}

model Deployment {
  id                String           @id @default(uuid())
  projectId         String
  artifactVersionId String
  status            DeploymentStatus @default(BUILDING)
  buildPath         String?
  errorMessage      String?          @db.Text
  createdAt         DateTime         @default(now())
  activatedAt       DateTime?

  project          Project         @relation("ProjectDeployments", fields: [projectId], references: [id], onDelete: Cascade)
  artifactVersion  ArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Restrict)
  activeForProject Project?        @relation("ActiveDeployment")
  dataMigrations   DataMigration[]

  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

model DataCollection {
  id                       String   @id @default(uuid())
  projectId                String
  key                      String
  name                     String
  activeDraftSchemaId      String?  @unique
  activeProductionSchemaId String?  @unique
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  project                Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schemas                DataSchemaVersion[] @relation("CollectionSchemas")
  activeDraftSchema      DataSchemaVersion?  @relation("ActiveDraftSchema", fields: [activeDraftSchemaId], references: [id], onDelete: SetNull)
  activeProductionSchema DataSchemaVersion?  @relation("ActiveProductionSchema", fields: [activeProductionSchemaId], references: [id], onDelete: SetNull)
  records                DataRecord[]

  @@unique([projectId, key])
  @@index([projectId, updatedAt])
}

model DataSchemaVersion {
  id            String           @id @default(uuid())
  collectionId  String
  versionNumber Int
  schema        Json
  status        DataSchemaStatus @default(DRAFT)
  createdAt     DateTime         @default(now())
  activatedAt   DateTime?

  collection              DataCollection  @relation("CollectionSchemas", fields: [collectionId], references: [id], onDelete: Cascade)
  draftForCollection      DataCollection? @relation("ActiveDraftSchema")
  productionForCollection DataCollection? @relation("ActiveProductionSchema")

  @@unique([collectionId, versionNumber])
  @@index([collectionId, status, createdAt])
}

model DataRecord {
  id            String          @id @default(uuid())
  projectId     String
  collectionId  String
  environment   DataEnvironment
  data          Json
  recordVersion Int             @default(1)
  createdById   String?
  updatedById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collection DataCollection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdBy  User?                @relation("DataRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?                @relation("DataRecordUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  revisions  DataRecordRevision[]

  @@index([projectId, collectionId, environment, deletedAt, createdAt])
  @@index([projectId, collectionId, environment, updatedAt])
}

model DataRecordRevision {
  id         String              @id @default(uuid())
  recordId   String
  operation  DataRecordOperation
  beforeData Json?
  afterData  Json?
  actorId    String?
  createdAt  DateTime            @default(now())

  record DataRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  actor  User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recordId, createdAt])
  @@index([actorId, createdAt])
}

model DataMigration {
  id                   String              @id @default(uuid())
  projectId            String
  deploymentId         String?
  fromSchemaVersionIds Json
  toSchemaVersionIds   Json
  changes              Json
  status               DataMigrationStatus @default(PENDING)
  errorMessage         String?             @db.Text
  createdAt            DateTime            @default(now())
  completedAt          DateTime?

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployment Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([deploymentId])
  @@index([status, createdAt])
}

model File {
  id                String          @id @default(uuid())
  artifactVersionId String
  path              String
  content           String
  artifactVersion   ArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)

  @@unique([artifactVersionId, path])
}

// 分享表
model Share {
  id                String          @id @default(uuid())
  shareCode         String          @unique @default(uuid()) // 分享链接唯一码
  artifactVersionId String
  artifactVersion   ArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@index([shareCode])
}

/// MCP 服务器配置表
model MCPConfig {
  id          String   @id @default(uuid())
  name        String
  url         String
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model checkpoint_blobs {
  thread_id     String
  checkpoint_ns String @default("")
  channel       String
  version       String
  type          String
  blob          Bytes?

  @@id([thread_id, checkpoint_ns, channel, version])
}

model checkpoint_migrations {
  v Int @id
}

model checkpoint_writes {
  thread_id     String
  checkpoint_ns String  @default("")
  checkpoint_id String
  task_id       String
  idx           Int
  channel       String
  type          String?
  blob          Bytes

  @@id([thread_id, checkpoint_ns, checkpoint_id, task_id, idx])
}

model checkpoints {
  thread_id            String
  checkpoint_ns        String  @default("")
  checkpoint_id        String
  parent_checkpoint_id String?
  type                 String?
  checkpoint           Json
  metadata             Json    @default("{}")

  @@id([thread_id, checkpoint_ns, checkpoint_id])
}
