# ==========================================
# 本地运行必需：PostgreSQL
# ==========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_generator"

# ==========================================
# 本地运行必需：Auth.js + GitHub OAuth
# AUTH_SECRET 可通过 `openssl rand -base64 32` 生成。
# GitHub OAuth callback URL:
# http://localhost:3000/api/auth/callback/github
# ==========================================
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
GITHUB_ID="your-github-oauth-app-client-id"
GITHUB_SECRET="your-github-oauth-app-client-secret"

# ==========================================
# AI 模型：至少配置所选模型对应的一组
# ==========================================

# 阿里云百炼业务空间（界面提供 Qwen 3.7 Flash 与 DeepSeek V4 Flash）
ALIYUN_API_KEY="your-dashscope-api-key"
ALIYUN_BASE_URL="https://your-workspace-id.your-region.maas.aliyuncs.com/compatible-mode/v1"

# Claude（通过 302.AI）
# AI302_API_KEY="your-302-ai-api-key"
# AI302_BASE_URL="https://api.302.ai/v1"

# Gemini
# GOOGLE_API_KEY="your-google-api-key"
# GOOGLE_MODEL_NAME="gemini-3-pro-preview"

# ==========================================
# 本地可选配置
# ==========================================

# 本地默认值已经指向 http://localhost:5174/sandbox.html，通常不要设置。
# 当前代码在 iframe URL 和 postMessage origin 中复用了此变量；跨域部署前需拆分配置。
# NEXT_PUBLIC_SANDBOX_URL="http://localhost:5174/sandbox.html"

# 生成分享链接时使用；本地未设置时默认 http://localhost:3000。
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 生产环境 Supabase 示例。当前 Prisma 配置实际读取 DATABASE_URL；
# DIRECT_URL 尚未接入 prisma.config.ts，不要仅配置 DIRECT_URL。
# DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxxx:password@db.xxxxx.supabase.co:5432/postgres"

# OPENAI_API_KEY 当前未被 lib/agent/models.ts 使用。
